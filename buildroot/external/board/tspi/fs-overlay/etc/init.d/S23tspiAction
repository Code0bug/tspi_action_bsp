#!/bin/sh

case "$1" in
    start)
        . /etc/tspi/tspiAction.sh
        echo "Waiting for rkaiq_3A_server..."
        tspi_action_wait_rkaiq || exit 1
        echo "Starting media-service..."
        tspi_action_prepare_dirs
        nohup /usr/bin/media-service >/var/run/tspi-action/media-service.log 2>&1 &
        tspi_action_wait_preview_sock || exit 1
        echo "Starting camera-ui..."
        nohup /usr/bin/camera-ui >/var/run/tspi-action/camera-ui.log 2>&1 &
        ;;
    stop)
        echo "Stopping camera-ui and media-service..."
        killall camera-ui media-service
        ;;
    restart)
        $0 stop
        sleep 1
        $0 start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac

exit 0
