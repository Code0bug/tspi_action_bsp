#!/bin/sh

case "$1" in
    start)
        echo "Waiting for rkaiq_3A_server..."
        i=0
        while ! pidof rkaiq_3A_server >/dev/null 2>&1; do
            i=$((i + 1))
            if [ "$i" -ge 50 ]; then
                echo "rkaiq_3A_server not running, media-service not started"
                exit 1
            fi
            sleep 0.1
        done
        sleep 0.1
        echo "Starting media-service..."
        mkdir -p /var/run/tspi-action
        nohup /usr/bin/media-service >/var/run/tspi-action/media-service.log 2>&1 &
        i=0
        while [ ! -S /run/tspi-action/preview.sock ]; do
            i=$((i + 1))
            if [ "$i" -ge 100 ]; then
                echo "preview.sock not ready, camera-ui not started"
                exit 1
            fi
            sleep 0.1
        done
        echo "Starting camera-ui..."
        export QT_QPA_PLATFORM=tspi
        nohup /usr/bin/camera-ui >/var/run/tspi-action/camera-ui.log 2>&1 &
        ;;
    stop)
        echo "Stopping camera-ui and media-service..."
        killall camera-ui media-service
        ;;
    restart)
        $0 stop
        sleep 1
        $0 start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac

exit 0
