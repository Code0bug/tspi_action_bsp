Date: Sat, 17 Oct 2026 20:20:30 +0800
Subject: [PATCH] icm42688p: shorten soft-reset delay from 100ms to 1ms

---
 drivers/iio/imu/my_icm42688p/icm42688p_asy.c | 7 +++----
 1 file changed, 3 insertions(+), 4 deletions(-)

diff --git a/drivers/iio/imu/my_icm42688p/icm42688p_asy.c b/drivers/iio/imu/my_icm42688p/icm42688p_asy.c
index 72a67d4c434b..5933190779d8 100755
--- a/drivers/iio/imu/my_icm42688p/icm42688p_asy.c
+++ b/drivers/iio/imu/my_icm42688p/icm42688p_asy.c
@@ -246,7 +246,7 @@ static int icm42688p_reginit(void)
     uint8_t reg_val = 0;
     icm42688p_write_onereg(&icm42688pdev, ICM42688_REG_BANK_SEL, 0); // 设置bank 0区域寄存器
     icm42688p_write_onereg(&icm42688pdev, ICM42688_DEVICE_CONFIG, 0x01); // 软复位传感器
-    mdelay(100);
+    mdelay(1);
 
     // 读取 who am i 寄存器 
     reg_val = icm42688p_read_onereg(&icm42688pdev, ICM42688_WHO_AM_I);
@@ -254,9 +254,8 @@ static int icm42688p_reginit(void)
 
     icm42688p_write_onereg(&icm42688pdev, ICM42688_REG_BANK_SEL, 0); // 设置bank 0区域寄存器
     icm42688p_write_onereg(&icm42688pdev, ICM42688_DEVICE_CONFIG, 0x01); // 软复位传感器
-
-	mdelay(100);
-
+	mdelay(1);
+	
 	if (reg_val == ICM42688_ID) {
 
 		icm42688p_write_onereg(&icm42688pdev, ICM42688_INT_CONFIG, 0x02);  // 设置INT1为推挽,低电平有效
-- 
2.25.1

