---
 common/mk-buildroot.sh                | 3 ++-
 rk356x/BoardConfig-rk3566-tspi-v10.mk | 2 ++
 2 files changed, 4 insertions(+), 1 deletion(-)

diff --git a/common/mk-buildroot.sh b/common/mk-buildroot.sh
index 73fe1ef..6f21b56 100755
--- a/common/mk-buildroot.sh
+++ b/common/mk-buildroot.sh
@@ -16,8 +16,9 @@ then
         echo "RK_CFG_BUILDROOT is empty, skip building buildroot rootfs!"
         exit 0
 fi
+export BR2_EXTERNAL=${BR2_EXTERNAL:-$TOP_DIR/tspi_action_bsp/buildroot/external}
 source $TOP_DIR/buildroot/build/envsetup.sh $RK_CFG_BUILDROOT
-$TOP_DIR/buildroot/utils/brmake
+$TOP_DIR/buildroot/utils/brmake BR2_EXTERNAL="$BR2_EXTERNAL"
 if [ $? -ne 0 ]; then
     echo "log saved on $TOP_DIR/br.log"
     tail -n 100 $TOP_DIR/br.log
diff --git a/rk356x/BoardConfig-rk3566-tspi-v10.mk b/rk356x/BoardConfig-rk3566-tspi-v10.mk
index d2472bf..5d26006 100755
--- a/rk356x/BoardConfig-rk3566-tspi-v10.mk
+++ b/rk356x/BoardConfig-rk3566-tspi-v10.mk
@@ -22,6 +22,8 @@ export RK_KERNEL_FIT_ITS=boot.its
 export RK_PARAMETER=parameter-buildroot-fit.txt
 # Buildroot config
 export RK_CFG_BUILDROOT=rockchip_rk3566
+# BR2_EXTERNAL: tspi_action_bsp overlay + packages
+export BR2_EXTERNAL=$TOP_DIR/tspi_action_bsp/buildroot/external
 # Recovery config
 export RK_CFG_RECOVERY=rockchip_rk356x_recovery
 # Recovery image format type: fit(flattened image tree)
