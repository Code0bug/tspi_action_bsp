---
 rk356x/BoardConfig-rk3566-tspi-v10.mk | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/rk356x/BoardConfig-rk3566-tspi-v10.mk b/rk356x/BoardConfig-rk3566-tspi-v10.mk
index 5d26006..72959a0 100755
--- a/rk356x/BoardConfig-rk3566-tspi-v10.mk
+++ b/rk356x/BoardConfig-rk3566-tspi-v10.mk
@@ -47,9 +47,9 @@ export RK_ROOTFS_IMG=rockdev/rootfs.${RK_ROOTFS_TYPE}
 # Set ramboot image type
 export RK_RAMBOOT_TYPE=
 # Set oem partition type, including ext2 squashfs
-export RK_OEM_FS_TYPE=ext2
+export RK_OEM_FS_TYPE=ext4
 # Set userdata partition type, including ext2, fat
-export RK_USERDATA_FS_TYPE=ext2
+export RK_USERDATA_FS_TYPE=ext4
 #OEM config
 export RK_OEM_DIR=oem_normal
 # OEM build on buildroot
